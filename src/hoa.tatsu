@@grammar::HOA
@@whitespace :: /[ \t\r\n]+/

identifier = /[a-zA-Z_][0-9a-zA-Z_-]*/ ;
integer = /0|[1-9][0-9]*/ ;
boolean = /[tf]/ ;
string = /"(\\.|[^\\"])*"/ ;
headername = /[a-zA-Z_][0-9a-zA-Z_-]*:/ ;
aname = /@[0-9a-zA-Z_-]+/ ;

automaton = header '--BODY--' body '--END--' ;
header = format_version {header_item}* ;
format_version = 'HOA:' identifier ;

header_item = states
            | start
            | ap
            | alias
            | acceptance
            | acc_name
            | tool
            | name
            | properties
            | other_header
            ;

states = 'States:' integer ;
start = 'Start:' state_conj ;
ap = 'AP:' integer {string}* ;
alias = 'Alias:' aname label_expr ;
acceptance = 'Acceptance:' integer acceptance_cond ;
acc_name = 'acc-name:' identifier {(boolean|integer|identifier)}* ;
tool = 'tool:' string [string] ;
name = 'name:' string ;
properties = 'properties:' {identifier}* ;
other_header = headername {(boolean|integer|string|identifier)}* ;

state_conj = integer {('&' integer)}* ;

acceptance_cond = identifier '(' ['!'] integer ')'
            | '(' acceptance_cond ')'
            | acceptance_cond '&' acceptance_cond
            | acceptance_cond '|' acceptance_cond
            | boolean
            ;

body = {state}+;

state = 'State:' integer {transition}+ ;
transition = '[' label_expr ']' integer ;

label_expr = boolean
        | integer
        | aname
        | '!' label_expr
        | '(' label_expr ')'
        | label_expr '&' label_expr
        | label_expr '|' label_expr
        ;